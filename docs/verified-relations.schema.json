{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reserved verified paper relations, not ingested in this release",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source", "target", "type", "verifiedAt", "evidence"],
    "properties": {
      "source": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "type": {"enum": ["cites", "explicitly_extends", "evaluates_on"]},
      "verifiedAt": {"type": "string", "format": "date"},
      "evidence": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "locator", "excerpt"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "locator": {"type": "string", "minLength": 1, "maxLength": 200},
            "excerpt": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        }
      }
    }
  }
}
