    "themes": [
      {
        "id": "evidence-and-action",
        "title": "先补证据，还是先行动？",
        "summary": "主动观察、执行偏离监控与目标完成验证，把证据放在不同的导航接口。",
        "shared_problem": "局部动作看似合理，不等于长期执行仍符合指令；不足的观测也可能被误当成足够证据。",
        "method_routes": [
          {
            "text": "SeekVLN 用专家未来动作构造补充视角和证据标注，再比较同状态的求证分支与直接导航分支，通过强化微调学习何时补观察。",
            "evidence_ids": [
              "2609.37353v1"
            ]
          },
          {
            "text": "AVERT-VLN 以独立 Monitor 异步检查指令与执行的一致性；接受 LOST 判定后暂停自主执行并请求人工指引，再把失败转成离线偏好学习数据。",
            "evidence_ids": [
              "2609.39579v1"
            ]
          },
          {
            "text": "NavHarness Adaptive Goals 将局部目标、动作执行、完成验证与历史压缩分工；验证目标完成后才压缩对应历史。",
            "evidence_ids": [
              "2609.39915v1"
            ]
          }
        ],
        "open_question": "应分别检查求证动作成本、人工介入频率与延迟、误判完成和压缩消融。AVERT 的成功率属于人工辅助评估；SeekVLN 需要训练；不能当作相同成本的自主系统排榜。",
        "evidence_ids": [
          "2609.37353v1",
          "2609.39579v1",
          "2609.39915v1"
        ],
        "related_topics": [
          "navigation_agents",
          "vln_objectnav"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "memory-validity",
        "title": "记忆何时可信，何时需要更新？",
        "summary": "持续经验、动态目标 belief 与搜索预算切换，对应三种不同的记忆和探索问题。",
        "shared_problem": "历史记录可能不完整、与新观测冲突，或在机器人到达前失效；保存更多历史并不能自动解决这些问题。",
        "method_routes": [
          {
            "text": "NavHarness Lifelong 在连续任务中复用地图、任务记录与房屋知识，同时检查新观测、记录修正并整理经验；结构化恢复交接与等长度总结的比较值得继续核查。",
            "evidence_ids": [
              "2609.34276v1"
            ]
          },
          {
            "text": "EvolvingNav 由带时间戳的物体历史预测检查时刻的目标占据状态，保留未知位置概率，并用视野条件检测概率处理负观测，避免同一证据重复计入。",
            "evidence_ids": [
              "2609.39166v2"
            ]
          },
          {
            "text": "SOR-Nav 以三维物体簇和可达前沿簇组织 ObjectNav，判断继续探索当前区域还是转移，重点是搜索预算分配。",
            "evidence_ids": [
              "2609.34707v1"
            ]
          }
        ],
        "open_question": "需核查旧证据冲突如何定位、负观测如何校准、去掉时间先验后的收益，以及相同预算下的整理增益。EvolvingNav 的摘要明确收益在可学习时间规律下最清楚，不能推广到任意随机变化。",
        "evidence_ids": [
          "2609.34276v1",
          "2609.39166v2",
          "2609.34707v1"
        ],
        "related_topics": [
          "spatial_episodic_memory",
          "navigation_agents"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "prediction-interface",
        "title": "预测信息进入哪一个决策接口？",
        "summary": "地图预测监督、长短期潜在导航引导与连续三维轨迹输出，不能只因同属世界模型就互换。",
        "shared_problem": "未来表示只有改变了可执行决策，才能支持导航；预测形式、使用时机与计算开销必须分开看。",
        "method_routes": [
          {
            "text": "InsightMap 用俯视地图作显式空间记忆和动作条件预测目标；地图预测是训练辅助监督，不能描述为部署时反复生成未来地图搜索。",
            "evidence_ids": [
              "2609.37187v1"
            ]
          },
          {
            "text": "ForeFly 为 UAV 长程指令跟随分开近未来与路线关键未来的潜在预测，并通过非对称动作细化接口利用二者。",
            "evidence_ids": [
              "2609.33581v1"
            ]
          },
          {
            "text": "DiffWAM 从冻结视频模型的预测特征恢复连续三维相机轨迹；完整视频生成和多帧重建用于离线监督，部署时跳过。FastDreamer 进行带时间戳的异步轨迹交接。",
            "evidence_ids": [
              "2609.39763v1"
            ]
          }
        ],
        "open_question": "需检查预测失误回退、相同观测预算的消融、端到端延迟与能耗。UAV、自建轨迹基准与地面 VLN 指标不能直接比较；模型流水线延迟不等于整体控制周期。",
        "evidence_ids": [
          "2609.37187v1",
          "2609.33581v1",
          "2609.39763v1"
        ],
        "related_topics": [
          "robot_world_models",
