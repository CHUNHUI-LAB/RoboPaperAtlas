    "themes": [
      {
        "id": "prediction-for-decisions",
        "title": "行动前的预测：适应环境、比较动作与预警异常",
        "summary": "三条路线分别更新环境条件潜变量、选择候选动作和预测交互异常。共同意义是把未来预测连接到一个具体决策接口；预测更准并不自动等于安全执行。",
        "shared_problem": "不可见物理因素、随机动作差异和接触异常分别怎样进入机器人下一步决策？",
        "method_routes": [
          {
            "text": "T2-Z 作者训练时交替优化世界模型与环境潜变量；部署时冻结模型，用一次或多次交互优化新环境潜变量。它针对未显式标注的环境差异，而不是直接筛选多个策略动作。",
            "evidence_ids": [
              "2610.22364v1"
            ]
          },
          {
            "text": "VeriVLA 作者用两次采样的块内时间变化和跨样本方差触发核验，再以 JEPA 潜世界模型预测任务进展，为动作块排序。训练自由指其触发机制，不能据此推断整个验证模型无需学习。",
            "evidence_ids": [
              "2610.21985v1"
            ]
          },
          {
            "text": "MAIA 作者以视觉—动作—力世界模型预测计划动作的视觉和受力后果，并用轻量异常头提前预警；摘要另报告利用预警进行动作选择，无需重训原操作策略。",
            "evidence_ids": [
              "2610.21686v1"
            ]
          }
        ],
        "open_question": "优先读 T2-Z 的适应接口，再对照 VeriVLA 的候选排序与 MAIA 的异常预警。需核查适应所需交互代价、错误排序、漏报和警报提前量；不同任务与硬件上的作者指标不能横向排名。",
        "evidence_ids": [
