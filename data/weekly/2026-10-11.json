      {
        "id": "whole-body-execution",
        "title": "全身执行：从人类动作表示到末端精度与负载平衡",
        "summary": "VioLA、ResGAC 与 HULK 分别处理示范接口、运动耦合和重载动力学。它们位于不同控制层，适合按接口依赖来阅读，而不是作为同一基准上的替代方案排序。",
        "shared_problem": "高层动作意图怎样变成在浮动基座、平衡和接触约束下可执行的全身运动？",
        "method_routes": [
          {
            "text": "VioLA 作者让通用策略预测身体与手部运动潜变量，再由预训练控制器执行；相应编码器把人类和机器人动作映射到共享空间，使人类记录进入策略的动作监督接口。",
            "evidence_ids": [
              "2610.12435v1"
            ]
          },
          {
            "text": "ResGAC 作者结合几何导纳控制与残差强化学习：前者给出末端任务空间反馈和名义关节目标，后者补偿动力学并协调平衡；地面附着航向参考系用于减少骨盆运动传到期望末端姿态。",
            "evidence_ids": [
              "2610.09479v1"
            ]
          },
          {
            "text": "HULK 作者以 MPC 对负载动力学的预测指导两个强化学习教师，分别覆盖腕部受力运动与抱持大物体行走；训练中加入捕获点控制障碍函数，并将教师蒸馏为一个策略。",
            "evidence_ids": [
              "2610.08970v1"
            ]
          }
        ],
