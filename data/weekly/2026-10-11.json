    "themes": [
      {
        "id": "action-faithful-worlds",
        "title": "预测可信度：让世界模型区分可执行动作与失败",
        "summary": "本窗口的三条路线分别改造训练反馈、失败数据和规划代价。共同目标是让预测对动作变化与失败后果敏感；视觉逼真或接近目标本身不足以证明可执行性。",
        "shared_problem": "当预测看似成功、实际执行却偏离时，如何定位模型的动作不敏感，并把一致性要求加入训练或决策？",
        "method_routes": [
          {
            "text": "DreamTrue 作者将动作轨迹渲染为空间条件，以离线几何校准改善动作对齐；再通过反事实轨迹及人类标注视频训练的奖励模型指导后训练，针对交互缺陷提供反馈。",
            "evidence_ids": [
              "2610.12468v1"
            ]
          },
          {
            "text": "CureWM 作者从成功演示构造不同程度的替代动作，通过仿真或硬件执行验证结果，再用失败及保留成功样本微调已有模型；摘要同时强调降低乐观预测和保持成功—失败区分能力。",
            "evidence_ids": [
              "2610.09134v1"
            ]
          },
          {
            "text": "ACID 作者不只评价预测终点，而以逆动力学从中间状态转移反推动作，将其与输入动作的循环一致性残差纳入规划代价。它处理的是决策时筛选，与前两篇的数据或后训练路线不同。",
            "evidence_ids": [
              "2607.02403v2"
            ]
          }
        ],
        "open_question": "优先对照 DreamTrue 与 CureWM 的失败反馈来源，再看 ACID 的决策时约束。需进一步核查真实失败覆盖、逆模型误差和统一闭环评测；摘要不能支持跨论文性能排名。",
        "evidence_ids": [
          "2610.12468v1",
          "2610.09134v1",
          "2607.02403v2"
        ],
        "related_topics": [
          "robot_world_models"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "compact-predictive-control",
        "title": "预测成本：压缩未来表示，保留有用历史",
        "summary": "三篇摘要分别把成本问题放在候选轨迹评价、未来监督目标和历史上下文处理上。它们减少或组织计算的位置不同，不能把训练加速与部署延迟直接比较。",
        "shared_problem": "在有限计算预算下，哪些未来和历史信息真正支持控制，哪些表示与重复计算可以简化？",
        "method_routes": [
          {
            "text": "LiteNWM 作者共享候选轨迹的视觉编码，并联合预测多个时间尺度的动作条件潜在表示，再由学习得到的评分器选轨迹；这是导航的候选评价接口。",
            "evidence_ids": [
              "2610.12368v1"
            ]
          },
          {
            "text": "MiniWAM 作者以逆动力学监督和特征重建学习 PRISM 紧凑未来目标，冻结目标编码器后联合训练动作与未来预测，主要针对世界—动作联合训练的高维监督成本。",
            "evidence_ids": [
              "2610.12194v1"
            ]
          },
          {
            "text": "Long-WAM 作者先进行自回归视频预训练，再保留历史到未来的因果结构用于动作学习；流式编码、异步执行和硬件相关加速服务于长历史的实时控制，而非简单删除未来预测。",
            "evidence_ids": [
              "2610.10528v1"
            ]
          }
        ],
        "open_question": "优先阅读 LiteNWM 与 MiniWAM 以区分推理评价和训练目标，再读 Long-WAM 的历史使用条件。需核查统一硬件、任务成功率、延迟尾部及信息压缩造成的失效情形。",
        "evidence_ids": [
          "2610.12368v1",
          "2610.12194v1",
          "2610.10528v1"
        ],
        "related_topics": [
          "robot_world_models"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "navigation-belief-and-runtime",
        "title": "导航闭环：记忆何时可信，何时重新观察",
        "summary": "本窗口将导航中的旧观测、隐蔽变化和突发事件分成信念更新、记忆呈现和运行时调度几个问题。以下是同一观察窗口内的方法对照，并非时间趋势判断。",
        "shared_problem": "机器人离开已观察区域后，怎样防止旧记忆被当作当前事实，并在需要时获取新证据或切换行动？",
        "method_routes": [
          {
            "text": "EvolvingNav 作者从带时间戳的三维目标历史构建持续／迁移信念，预测检查时刻的位置，并以可见性相关的负观测更新概率；ALONE 则传播几何空间信念，在可靠性不足且新观测有望补足信息时请求深度观测。前者侧重目标隐蔽移动，后者侧重感知间歇。",
            "evidence_ids": [
              "2609.39166v3",
              "2610.11591v1"
            ]
          },
          {
            "text": "MarvisNav 作者把拓扑候选节点及探索状态投影到当前视图，使目标相关性和探索进度在视觉路线选项中共同呈现，减少让 VLM 从分离记忆中重新建立对应关系的需求。",
            "evidence_ids": [
              "2610.06510v1"
            ]
          },
          {
            "text": "NavGPT-3 作者把推理、行动和监控置于各自的上下文与工具线程中，由运行时调度、中断和切换机器人运动控制权；这属于推理—低层动作之间的执行接口，而非目标位置概率模型。",
            "evidence_ids": [
              "2610.10787v1"
            ]
          }
        ],
        "open_question": "优先对照 EvolvingNav 与 ALONE 对不确定性和再观察条件的定义。继续核查变化模式失配、漏检校准、重复证据和调度延迟；各文任务设定不同，不能据摘要断言通用导航能力。",
        "evidence_ids": [
          "2609.39166v3",
          "2610.11591v1",
          "2610.06510v1",
          "2610.10787v1"
        ],
