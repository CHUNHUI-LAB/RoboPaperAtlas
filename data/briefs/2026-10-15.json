    "themes": [
      {
        "id": "selective-adaptation",
        "title": "策略适应：残差、数据加权与按需更新",
        "summary": "四篇摘要从不同位置处理已有策略的任务适应；共同点是避免把所有数据或能力变化一视同仁。",
        "shared_problem": "已有机器人策略遇到新任务或执行失败时，如何决定调整什么以及使用哪些经验？",
        "method_routes": [
          {
            "text": "HiRe-MoMa冻结基策略，以底盘和机械臂分层残差配合稀疏人工价值引导；GR-BC则在离线后训练中，根据图上目标距离的变化重加权动作块。",
            "evidence_ids": [
              "2610.20607v1",
              "2610.20504v1"
            ]
          },
          {
            "text": "AdaRSI在RoboCasa365仿真任务中先调整harness，再从保存状态重试子步骤，仅微调仍不可靠的部分；MorphAct则用上下文相关的低秩参数生成器同时适应视觉语言与动作模块。",
            "evidence_ids": [
              "2610.20474v1",
              "2610.20019v1"
            ]
          }
        ],
        "open_question": "需要分别核查在线交互、离线rollout、自采演示及上下文参数生成的成本与失败定义；这些机制没有统一评测，不能横向排优劣。",
        "evidence_ids": [
          "2610.20607v1",
          "2610.20504v1",
          "2610.20474v1",
          "2610.20019v1"
        ],
        "related_topics": [
          "mobile_manipulation",
          "robot_vla"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "structured-observation",
        "title": "操作感知：对象状态、相机几何与主动取景",
        "summary": "三篇摘要分别通过对象组织、标定几何和下一步观察区域选择补足VLA视觉信息。",
        "shared_problem": "通用视觉骨干提供的图像表征，如何保留实际操作所需的对象关系与局部细节？",
        "method_routes": [
          {
            "text": "ObjDream将对象身份与状态分离，并用训练阶段的未来对象状态预测辅助学习；G³VLA将相机内外参与跨视角融合注入视觉token。",
            "evidence_ids": [
              "2610.20223v1",
              "2606.24472v2"
            ]
          },
          {
            "text": "FoveaVLA与动作块一起预测下次查询的观察区域，将原分辨率裁剪与全景视图送入策略；它利用外部相机恢复局部细节。",
            "evidence_ids": [
              "2610.20064v1"
            ]
          }
        ],
        "open_question": "需要核查各路线在对象遮挡、标定误差、视角变化及传感配置变化时的失效边界；G³VLA仅核查当前v2摘要，没有证明修订新增了什么。",
        "evidence_ids": [
          "2610.20223v1",
          "2606.24472v2",
          "2610.20064v1"
        ],
        "related_topics": [
          "robot_vla"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "action-representations",
        "title": "动作表征：离散依赖与接触潜变量",
        "summary": "离散控制、交互潜变量和径向潜动作分别强调动作维度依赖、接触演化及变化幅度与模式。",
        "shared_problem": "怎样的动作表征能保留执行结构，而不只拟合一段运动轨迹？",
        "method_routes": [
          {
            "text": "离散动作比较研究把主要困难归于时间与动作维度的因子化误差，考察离散flow与引导等干预；其结论是作者在所测设置中的观察。",
            "evidence_ids": [
              "2610.20429v1"
            ]
          },
          {
            "text": "ILA把运动、接触和力共同编码成可解码的交互潜变量；PoLAR用径向与方向结构区分变化幅度和模式，借时间间隔作弱监督。",
            "evidence_ids": [
              "2610.18855v2",
              "2606.21139v2"
            ]
          }
        ],
        "open_question": "需要核查表征结构、解码器与训练数据各自的贡献；ILA和PoLAR是当前修订版摘要，未做版本差异核验。",
        "evidence_ids": [
          "2610.20429v1",
          "2610.18855v2",
          "2606.21139v2"
        ],
        "related_topics": [
          "robot_vla"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "world-action-execution",
        "title": "世界动作模型：执行约束与计算预算",
        "summary": "三篇世界动作模型摘要分别处理局部运动条件、持续学习回放和未来token计算开销。",
        "shared_problem": "联合生成未来视觉与动作时，如何让生成内容持续服务于可执行动作？",
        "method_routes": [
          {
            "text": "Atomic-WAM通过原子运动描述连接推理与执行，并在固定WAM时用执行奖励适应推理器；R²-WAM则截断已完成任务的生成回放并滤除动作与观察不一致的rollout。",
            "evidence_ids": [
              "2610.20157v1",
              "2610.18038v2"
            ]
          },
          {
            "text": "CF-Prune利用指令与动作注意力筛选未来帧token，并在精细操作阶段保留稠密计算；这是推理剪枝路线，不等同于回放或推理器后训练。",
            "evidence_ids": [
              "2610.19957v1"
            ]
          }
        ],
        "open_question": "需要核查执行适当性、回放一致性与精度阶段判定是否可靠，以及速度与成功率的统计设置；不把生成的合理视频等同于正确动作。",
        "evidence_ids": [
          "2610.20157v1",
          "2610.18038v2",
          "2610.19957v1"
        ],
        "related_topics": [
          "robot_world_models"
        ],
        "attribution": "curator_synthesis",
        "comparison_scope": "within_window_no_temporal_trend"
      },
      {
        "id": "navigation-execution",
        "title": "导航评测：团队目标与实际执行",
        "summary": "两篇摘要分别扩展团队目标组合和人形机器人运动执行约束，提醒导航评测不应只看高层路径。",
        "shared_problem": "目标如何分配给团队，且高层导航意图如何与实际机器人状态保持一致？",
        "method_routes": [
          {
            "text": "HM3D-M3把多智能体、多种目标模态和多目标放进同一episode，比较分层目标分配与共享地图VLM团队。",
            "evidence_ids": [
              "2610.20121v1"
            ]
          },
          {
            "text": "人形导航研究将高度图难辨的危险与指令执行偏差纳入基准，并用闭环VLN与运动控制持续对齐实际状态。",
            "evidence_ids": [
              "2610.07396v2"
            ]
          }
        ],
        "open_question": "需要分别核查团队效率指标、危险接触指标和实机验证范围；人形导航v2的仿真导航与实机运动控制验证不能混为全面硬件导航验证。",
        "evidence_ids": [
          "2610.20121v1",
          "2610.07396v2"
        ],
